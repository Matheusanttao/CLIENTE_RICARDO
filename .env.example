# URL pública do app (sem barra final). Ex.: http://localhost:5173 ou https://www.seudominio.com.br
# Usada também no build para og:image, canonical, robots.txt e sitemap.xml.
VITE_APP_URL=http://localhost:5173

# Supabase — Project Settings > API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# NUNCA coloque SUPABASE_SERVICE_ROLE_KEY no frontend.
# Use apenas em Edge Functions / scripts de servidor.
